{
  "functions": {
    "api/webhook.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/zara.js": {
      "memory": 128,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.js"
    },
    {
      "source": "/api/zara",
      "destination": "/api/zara.js"
    }
  ]
}
